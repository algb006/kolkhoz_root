# Line endings: LF in the repository, LF in the working tree.
# The core is edited on Linux and built on Windows over rsync — mixed endings
# would show up as spurious diffs and confuse MSVC.
* text=auto eol=lf

# Windows-only wrappers must keep CRLF: cmd.exe chokes on LF in some cases.
# PowerShell tolerates LF but reads a BOM-less file as ANSI, so win-setup.ps1
# is kept as UTF-8 with BOM — its messages are in Russian.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Explicit text types
*.c        text
*.cc       text
*.cpp      text
*.h        text
*.hpp      text
*.inl      text
*.cmake    text
*.txt      text
*.md       text
*.py       text
*.sh       text eol=lf
*.json     text
*.csv      text
Makefile   text
Doxyfile   text

# Binaries: never convert, never diff as text
*.a        binary
*.lib      binary
*.so       binary
*.dll      binary
*.exe      binary
*.pdb      binary
*.obj      binary
*.o        binary
*.png      binary
*.jpg      binary
*.zip      binary
