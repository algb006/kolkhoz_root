#!/usr/bin/env bash
# Refuses a push whose commits carry a placeholder in their message: a word
# like CANON_PENDING, SUITE_PENDING, SHA_PENDING - what a message holds while
# its measure is still running, and what it must not hold once it leaves.
#
# WHY A HOOK AND NOT A GREP BEFORE THE PUSH: twice in a week (0.36.21 and
# 0.36.29, 4d01c21) a message went out with CANON_PENDING. The second time
# a grep guarded the amend that would have replaced it; the phrase it looked
# for had been wrapped over two lines, the grep failed quietly, the amend
# never ran - and the push, a separate statement, did not depend on it
# (boss, 2026-09-26: «чини не память, а сторожа»). Here the push cannot go
# without the check: git runs this and stops on a non-zero exit.
#
# THE TEXT IS NORMALISED FIRST: the message on one line, runs of blanks as
# one, and a placeholder broken by a wrap ("CANON_" at a line's end,
# "PENDING" at the next line's start) still matches. Only the commits the
# remote does not have yet are read - the history already out holds the old
# slips and cannot be rewritten. A message that must NAME a placeholder
# writes it another way (CANON-PENDING, "the placeholder").
#
# ONE WAY PAST IT, and only one (boss-core-seed-ladders [4], 2026-09-27): a
# commit whose placeholder is RECORDED ABOVE IT IN THE SAME PUSH — a later
# commit of this push, descended from it, whose message names its sha (7
# characters) with the numbers it was waiting for. Checked by the sha, not
# by a word like "Record": a record about another commit does not pass.
# The case: 0.36.35 and 0.36.36 were committed over 0.36.34 before its
# canon came back; only HEAD can be amended, rewording the two below needs
# a rebase, which the role does not run — and the numbers went into
# 0.36.36's message instead. The numbers themselves are the writer's to
# give; this checks only that the record names the commit.
#
# Git calls it with the remote's name and URL as arguments and one line a
# ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.

set -euo pipefail

zero="0000000000000000000000000000000000000000"
refused=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue # a deletion carries no message
  fi
  if [ "$remote_sha" = "$zero" ]; then
    commits="$(git rev-list "$local_sha" --not --remotes)"
  else
    commits="$(git rev-list "$remote_sha..$local_sha")"
  fi
  for commit in $commits; do
    text="$(git log -1 --format=%B "$commit" | tr '\n' ' ' | tr -s '[:space:]' ' ')"
    found="$(printf '%s' "$text" | grep -Eo '[A-Z]+_[[:space:]]?PENDING' | sort -u | tr '\n' ' ' || true)"
    if [ -n "$found" ]; then
      # RECORDED ABOVE IT IN THE SAME PUSH: a later commit of this push whose
      # message names this commit's sha carries its numbers (see the header).
      short="$(git rev-parse --short=7 "$commit")"
      recorded=""
      for later in $commits; do
        if [ "$later" != "$commit" ] && git merge-base --is-ancestor "$commit" "$later" &&
          git log -1 --format=%B "$later" | tr '\n' ' ' | grep -q "$short"; then
          recorded="$later"
          break
        fi
      done
      if [ -n "$recorded" ]; then
        echo "pre-push: $(git log -1 --format='%h %s' "$commit" | cut -c1-60)" >&2
        echo "pre-push:   заглушка ${found}— числа записаны выше: $(git log -1 --format='%h' "$recorded")" >&2
        continue
      fi
      echo "pre-push: $(git log -1 --format='%h %s' "$commit" | cut -c1-72)" >&2
      echo "pre-push:   в сообщении заглушка: ${found}— замени её числами и повтори" >&2
      refused=1
    fi
  done
done

exit "$refused"
